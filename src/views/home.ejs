<%- include('partials/header', { title, currentPage }) %>
<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">CSE 340 Service Network</p>
        <h1><%= title %></h1>
        <h2>Make a difference, together.</h2>
        <p class="lead">Our mission is to promote service across the world by connecting volunteers with service opportunities in their community.</p>
        <a class="button-link" href="/projects">Explore service projects</a>
    </div>
    <img class="hero-image" src="/images/cse340-service-network.png" alt="CSE 340 Service Network logo">
</section>
<section class="intro-section" aria-labelledby="welcome-heading">
    <p class="eyebrow">A stronger community starts with you</p>
    <h2 id="welcome-heading">Find a way to serve</h2>
    <p>Discover local opportunities, meet organizations doing meaningful work, and find a project that matches your interests.</p>
</section>
<%- include('partials/footer') %>
