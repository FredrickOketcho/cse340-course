<%- include('partials/header', { title, currentPage }) %>
<section class="page-intro">
    <p class="eyebrow">Find the cause that moves you</p>
    <h1><%= title %></h1>
    <p class="lead">Explore service opportunities by the kind of impact you want to make.</p>
</section>
<section class="card-grid category-grid" aria-label="Service project categories">
    <% categories.forEach((category, index) => { %>
        <article class="content-card category-card">
            <span class="category-icon" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
            <h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2>
        </article>
    <% }) %>
</section>
<%- include('partials/footer') %>
