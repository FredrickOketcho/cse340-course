<%- include('partials/header', { title, currentPage }) %>
<h1><%= title %></h1>

<form action="/edit-project/<%= project.project_id %>" method="POST">
    <div class="form-group">
        <label for="title">Project Title</label>
        <input type="text" id="title" name="title" value="<%= project.title %>" maxlength="200" required>
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" maxlength="999" required><%= project.description %></textarea>
    </div>

    <div class="form-group">
        <label for="location">Location</label>
        <input type="text" id="location" name="location" value="<%= project.location %>" maxlength="199" required>
    </div>

    <div class="form-group">
        <label for="date">Project Date</label>
        <input type="date" id="date" name="date" value="<%= project.date_input %>" required>
    </div>

    <div class="form-group">
        <label for="organizationId">Organization</label>
        <select id="organizationId" name="organizationId" required>
            <% organizations.forEach((organization) => { %>
                <option value="<%= organization.organization_id %>" <% if (organization.organization_id === project.organization_id) { %>selected<% } %>>
                    <%= organization.name %>
                </option>
            <% }); %>
        </select>
    </div>

    <button type="submit">Update Service Project</button>
</form>
<p><a href="/project/<%= project.project_id %>">Cancel</a></p>
<%- include('partials/footer') %>
