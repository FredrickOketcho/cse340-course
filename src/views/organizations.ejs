<%- include('partials/header', { title, currentPage }) %>
<section class="page-intro">
    <p class="eyebrow">Working together for good</p>
    <h1><%= title %></h1>
    <p class="lead">Meet the community partners creating meaningful ways to serve.</p>
</section>
<section class="card-grid organization-grid" aria-label="Partner organizations">
    <% organizations.forEach((organization) => { %>
        <article class="content-card organization-card">
            <% if (organization.logo_filename) { %>
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
            <% } %>
            <div>
                <h2><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></h2>
                <p><%= organization.description %></p>
                <a href="mailto:<%= organization.email %>"><%= organization.email %></a>
            </div>
        </article>
    <% }) %>
</section>
<%- include('partials/footer') %>
