<%- include('partials/header', { title, currentPage }) %>
<h1><%= title %></h1>

<form action="/edit-category/<%= category.category_id %>" method="POST">
    <div class="form-group">
        <label for="name">Category Name</label>
        <input type="text" id="name" name="name" value="<%= category.name %>" minlength="3" maxlength="80" required>
    </div>
    <button type="submit">Update Category</button>
</form>
<p><a href="/category/<%= category.category_id %>">Cancel</a></p>
<%- include('partials/footer') %>
