<%- include('partials/header', { title, currentPage }) %>
<section class="page-intro">
    <p class="eyebrow">Service project details</p>
    <h1><%= project.title %></h1>
</section>
<article class="content-card project-card">
    <p><%= project.description %></p>
    <p><strong>Date:</strong> <%= project.date %></p>
    <p><strong>Location:</strong> <%= project.location || 'To be announced' %></p>
    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <% if (categories.length > 0) { %>
        <p><strong>Categories:</strong></p>
        <ul class="category-tags" aria-label="Project categories">
            <% categories.forEach((category) => { %>
                <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
            <% }) %>
        </ul>
    <% } %>
</article>
<%- include('partials/footer') %>
